#!/bin/bash
# Record a call as two tracks: the microphone and whatever the speakers play.
#
#   meeting-record toggle       start, or stop and hand the recording over
#   meeting-record note         start a quick voice note (microphone only),
#                               or end it and hand it over; bound to a key,
#                               so it is press, talk, press
#   meeting-record note quiet   the same, but the note also ends by itself
#                               once you fall silent (for the headset button,
#                               which can start a note but not stop it)
#   meeting-record note-stop    end a note; used by the safety timer
#   meeting-record status       one line of JSON for waybar
#
# A finished recording goes to the voice-diary bot on leopardus, which
# transcribes it and asks in Matrix what to record. Recordings made elsewhere
# wait in the outbox until leopardus can be reached over ssh.
#
# Both tracks follow the default devices, so switching headset mid-call works.
set -u

DATA="${MEETING_RECORD_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/meeting-record}"
RUN="${XDG_RUNTIME_DIR:-/tmp}/meeting-record"
INBOX_HOST="${MEETING_RECORD_HOST:-leopardus}"
INBOX="${MEETING_RECORD_INBOX:-.local/state/voice-diary/meetings/inbox}"
RETRY_SECONDS=300
NOTE_MIN_MS=600   # a shorter note is taken for a slip of the finger
NOTE_MAX_SECONDS=300 # stop by itself if the second press never comes
NOTE_QUIET_SECONDS="${MEETING_RECORD_QUIET:-3}" # end a note after this much silence
NOTE_WAIT_SECONDS=10 # give up on a note nobody speaks into
mkdir -p "$DATA/outbox" "$RUN"

# One line per key event, to tell a lost key release from a fault in here.
log() {
	echo "$(date --iso-8601=seconds) $*" >> "$DATA/log"
}

recording() {
	[ -f "$RUN/id" ] && kill -0 "$(cat "$RUN/mic.pid" 2>/dev/null)" 2>/dev/null
}

capture() { # device, file, pid file
	setsid parecord --device="$1" --rate=16000 --channels=1 --file-format=flac --latency-msec=100 \
		--client-name=meeting-record "$2" >/dev/null 2>&1 &
	echo $! > "$3"
}

start() {
	local id dir
	id=$(date +%Y-%m-%dT%H%M%S)
	dir="$DATA/outbox/$id"
	mkdir -p "$dir"
	date --iso-8601=seconds > "$dir/started"
	capture @DEFAULT_SOURCE@ "$dir/mic.flac" "$RUN/mic.pid"
	capture @DEFAULT_MONITOR@ "$dir/out.flac" "$RUN/out.pid"
	echo "$id" > "$RUN/id"
}

# Close a recording: write its metadata and mark it ready to hand over.
finish() { # dir, end time
	local kind=meeting
	[ -e "$1/out.flac" ] || kind=note
	printf '{"kind": "%s", "started": "%s", "ended": "%s", "host": "%s"}\n' \
		"$kind" "$(cat "$1/started")" "$2" "$(hostname)" > "$1/meta.json"
	touch "$1/ready"
}

# Short tones on the default output, so a note can be started and ended
# without looking: rising = recording, falling = sent, one low = dropped.
chime() { # start|sent|dropped
	local f
	case "$1" in
	start) set -- 660 990 ;;
	sent) set -- 990 660 ;;
	*) set -- 330 ;;
	esac
	# One stream for all tones, led by 0.3 s of silence: the headset swallows
	# the first moment of sound while its output wakes up.
	local files=()
	for f in "$@"; do
		[ -s "$RUN/tone-$f.wav" ] ||
			sox -q -n -r 48000 -c 1 "$RUN/tone-$f.wav" synth 0.12 sine "$f" fade 0.01 0.12 0.02 pad 0 0.03 vol 0.4
		files+=("$RUN/tone-$f.wav")
	done
	play -q "${files[@]}" pad 0.3 0
} >/dev/null 2>&1

noting() {
	[ -f "$RUN/note-id" ] && kill -0 "$(cat "$RUN/note.pid" 2>/dev/null)" 2>/dev/null
}

note_start() {
	local id dir
	noting && return 0
	id="$(date +%Y-%m-%dT%H%M%S)-note"
	dir="$DATA/outbox/$id"
	mkdir -p "$dir"
	date --iso-8601=seconds > "$dir/started"
	date +%s%3N > "$RUN/note-t0"
	# Beep before the microphone opens: once it records, the Jabra is in call
	# mode and plays nothing. The beep blocks (about 0.6 s), and the microphone
	# opens straight after it, so it means "talk now".
	chime start
	capture @DEFAULT_SOURCE@ "$dir/mic.flac" "$RUN/note.pid"
	echo "$id" > "$RUN/note-id"
	(sleep "$NOTE_MAX_SECONDS"; rm -f "$RUN/note-dog"; echo "$(date --iso-8601=seconds) timer: stop" >> "$DATA/log"; bash "$0" note-stop) >/dev/null 2>&1 &
	echo $! > "$RUN/note-dog"
	[ "${1:-}" = quiet ] || return 0
	# A second, raw stream of the same microphone, only to hear when talking stops.
	(parec --device=@DEFAULT_SOURCE@ --raw --format=s16le --rate=16000 --channels=1 \
		--latency-msec=100 --client-name=meeting-record-vad 2>/dev/null |
		python3 -I -c "$QUIET_PY" "$NOTE_QUIET_SECONDS" "$NOTE_WAIT_SECONDS" 2>> "$DATA/log" &&
		{ rm -f "$RUN/note-quiet"; log "silence: stop"; bash "$0" note-stop; }) >/dev/null 2>&1 &
	echo $! > "$RUN/note-quiet"
}

# Reads 16 kHz mono s16le on stdin; exits 0 once the speaker has been quiet for
# argv[1] seconds after talking (or never talked within argv[2] seconds), and
# non-zero when the stream ends first. Speech is anything 12 dB over a noise
# floor that drops at once and rises 1 dB/s, so it follows a steady background.
QUIET_PY='
import array, math, sys, time
quiet_for, wait_for = float(sys.argv[1]), float(sys.argv[2])
frame = 1600  # 100 ms
floor, heard, quiet, t, peak = -55.0, False, 0.0, 0.0, -96.0
while True:
    b = sys.stdin.buffer.read(frame * 2)
    if len(b) < frame * 2:
        sys.exit(1)
    a = array.array("h", b)
    rms = math.sqrt(sum(x * x for x in a) / len(a)) or 1.0
    db = 20 * math.log10(rms / 32768)
    t += 0.1
    if t < 0.5:  # the click of the key
        continue
    peak = max(peak, db)
    if db > max(floor + 12, -50):
        heard, quiet = True, 0.0
    else:
        quiet += 0.1
    floor = min(db, floor + 0.1)
    if (heard and quiet >= quiet_for) or (not heard and t >= wait_for):
        print(time.strftime("%Y-%m-%dT%H:%M:%S%z"), "silence: after %.1fs, peak %.0f dB, floor %.0f dB, speech %s" % (t, peak, floor, heard), file=sys.stderr)
        sys.exit(0)
'

note_stop() {
	local dir pid held dog nap
	noting || return 0
	dir="$DATA/outbox/$(cat "$RUN/note-id")"
	pid=$(cat "$RUN/note.pid")
	held=$(($(date +%s%3N) - $(cat "$RUN/note-t0")))
	if [ -f "$RUN/note-dog" ]; then # the key was released in time; the safety timer is not needed
		dog=$(cat "$RUN/note-dog")
		nap=$(pgrep -P "$dog")
		# The timer shell first: killing its sleep alone would let it run on and stop a later note.
		kill "$dog" $nap 2>/dev/null
	fi
	if [ -f "$RUN/note-quiet" ]; then # the silence watcher and its two processes
		dog=$(cat "$RUN/note-quiet")
		kill "$dog" $(pgrep -P "$dog") 2>/dev/null
	fi
	rm -f "$RUN/note-id" "$RUN/note.pid" "$RUN/note-t0" "$RUN/note-dog" "$RUN/note-quiet"
	sleep 0.3 # the last word is still on its way through the audio buffers
	kill -INT "$pid" 2>/dev/null
	for _ in $(seq 30); do
		kill -0 "$pid" 2>/dev/null || break
		sleep 0.1
	done
	if [ "$held" -lt "$NOTE_MIN_MS" ]; then
		chime dropped &
		rm -rf "$dir"
	else
		chime sent &
		finish "$dir" "$(date --iso-8601=seconds)"
	fi
}

stop() {
	local dir pid
	dir="$DATA/outbox/$(cat "$RUN/id")"
	for pid in "$(cat "$RUN/mic.pid")" "$(cat "$RUN/out.pid")"; do
		kill -INT "$pid" 2>/dev/null
	done
	for _ in $(seq 50); do # give the encoders up to five seconds to flush
		kill -0 "$(cat "$RUN/mic.pid")" 2>/dev/null || kill -0 "$(cat "$RUN/out.pid")" 2>/dev/null || break
		sleep 0.1
	done
	rm -f "$RUN/id" "$RUN/mic.pid" "$RUN/out.pid"
	finish "$dir" "$(date --iso-8601=seconds)"
}

# A recording cut short by a crash or logout never got closed; close it now.
adopt_orphans() {
	local dir
	for dir in "$DATA"/outbox/*/; do
		[ -f "$dir/started" ] && [ ! -f "$dir/ready" ] || continue
		[ "$(basename "$dir")" = "$(cat "$RUN/note-id" 2>/dev/null)" ] && continue
		finish "${dir%/}" "$(date --iso-8601=seconds -r "$dir/mic.flac" 2>/dev/null || date --iso-8601=seconds)"
	done
}

deliver() {
	local dir id
	exec 9> "$RUN/deliver.lock"
	flock -n 9 || return 0
	date +%s > "$RUN/last-try"
	for dir in "$DATA"/outbox/*/; do
		[ -f "$dir/ready" ] || continue
		dir="${dir%/}"
		id=$(basename "$dir")
		# "ready" goes last, so the bot never picks up a half-copied recording.
		if [ "$(hostname)" = "$INBOX_HOST" ]; then
			mkdir -p "$HOME/$INBOX/$id" &&
				cp "$dir"/*.flac "$dir/meta.json" "$HOME/$INBOX/$id/" &&
				touch "$HOME/$INBOX/$id/ready" && rm -rf "$dir"
		else
			rsync -a --exclude ready -e "ssh -o BatchMode=yes -o ConnectTimeout=5" "$dir/" "$INBOX_HOST:$INBOX/$id/" &&
				ssh -o BatchMode=yes -o ConnectTimeout=5 "$INBOX_HOST" "touch '$INBOX/$id/ready'" && rm -rf "$dir"
		fi
	done
}

waiting() {
	find "$DATA/outbox" -mindepth 2 -maxdepth 2 -name ready | wc -l
}

status() {
	local since elapsed count
	if noting; then
		printf '{"text": "\uf130", "class": "recording", "tooltip": "Recording a voice note. Press the key again to send it."}\n'
		return
	fi
	if recording; then
		since=$(date +%s -d "$(cat "$DATA/outbox/$(cat "$RUN/id")/started")")
		elapsed=$(($(date +%s) - since))
		printf '{"text": " %02d:%02d", "class": "recording", "tooltip": "Recording a meeting. Click to stop."}\n' \
			$((elapsed / 60)) $((elapsed % 60))
		return
	fi
	adopt_orphans
	count=$(waiting)
	if [ "$count" -gt 0 ]; then
		if [ $(($(date +%s) - $(cat "$RUN/last-try" 2>/dev/null || echo 0))) -ge "$RETRY_SECONDS" ]; then
			(deliver >/dev/null 2>&1 &)
		fi
		printf '{"text": " %d", "class": "waiting", "tooltip": "%d recording(s) waiting to reach %s. Click to record a meeting."}\n' \
			"$count" "$count" "$INBOX_HOST"
	else
		printf '{"text": "", "class": "idle", "tooltip": "Click to record a meeting."}\n'
	fi
}

case "${1:-}" in
toggle)
	if recording; then
		stop
		(deliver >/dev/null 2>&1 &)
	else
		start
	fi
	pkill -RTMIN+9 waybar
	;;
note)
	if noting; then
		log "press: stop"
		note_stop
		(deliver >/dev/null 2>&1 &)
	else
		log "press: start${2:+ $2}"
		note_start "${2:-}"
	fi
	pkill -RTMIN+9 waybar
	;;
note-stop)
	note_stop
	pkill -RTMIN+9 waybar
	(deliver >/dev/null 2>&1 &)
	;;
status) status ;;
deliver) deliver ;;
*)
	echo "usage: meeting-record toggle|note|note-stop|status|deliver" >&2
	exit 2
	;;
esac
