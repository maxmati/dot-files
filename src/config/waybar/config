[
// Main screen: workspaces plus the full set of stats.
{
	<?php if (gethostname() === "leopardus"): ?>
	"output": "DP-1",
	<?php endif ?>
	"height": 36,
    "layer": "top",
	"position": "bottom",
    "modules-left": ["sway/workspaces", "sway/mode"],
//    "modules-center": ["sway/window"],
    "modules-right": [
    	"disk#zfs", 
	"disk#root",
	"disk#home","cpu",
	"memory",
	"temperature#cpu",
	"temperature#gpu",
	"network",
	"pulseaudio",
	<?php if (gethostname() === "felis"): ?>
	"battery",
	<?php elseif (gethostname() === "leopardus"): ?>
	"upower#headset",
	"upower#mouse",
	<?php endif ?>
	"custom/dnd",
	"idle_inhibitor",
	"tray", 
	"clock"
	],
	"sway/workspaces": {
		"format": "{name}",
		"enable-bar-scroll": true
	},
	"idle_inhibitor": {
	    "format": "{icon}",
		"format-icons": {
	        "activated": "",
			"deactivated": ""
		}
	},
	// Notification snooze: toggles mako's do-not-disturb mode. Plain-text
	// output: line 1 text, line 2 tooltip, line 3 CSS class.
	"custom/dnd": {
		"exec": "if makoctl mode | grep -qx do-not-disturb; then printf '%s\\n%s\\n%s\\n' '' 'Notifications snoozed' activated; else printf '%s\\n%s\\n%s\\n' '' 'Notifications on' deactivated; fi",
		"interval": 10,
		"signal": 8,
		"on-click": "makoctl mode -t do-not-disturb; pkill -RTMIN+8 waybar"
	},
	"disk#zfs": {
		"path": "/zfs/backup",
		"format": "/zfs: {percentage_free}%",
		"tooltip-format": "{used} out of {total} used ({percentage_used}%), {free} free"
	},
	"disk#root": {
		"path": "/root",
		"format": "/root: {percentage_free}%",
		"tooltip-format": "{used} out of {total} used ({percentage_used}%), {free} free"
	},
	"disk#home": {
		"path": "/home",
		"format": "/home: {percentage_free}%",
		"tooltip-format": "{used} out of {total} used ({percentage_used}%), {free} free"
	},
	"tray": {
		"spacing": 10
	},
    "sway/window": {
        "max-length": 50
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    // Peripheral batteries, both matched on model (see `upower --dump`)
    // rather than native-path, because the device paths move: the mouse's
    // hidpp_battery_N index shifts between reconnects, and the headset's path
    // changed outright when its battery went from a userspace daemon to a
    // kernel driver.
    //
    // show-icon is off for both: it draws an icon-theme image that does not
    // match the flat glyphs the rest of the bar uses. Without min-length the
    // label gets ellipsized to "..." on a full bar.
    "upower#headset": {
        "model": "Jabra Evolve3 75",
        "format": "{percentage} ",
        "format-alt": "{percentage} {time} ",
        "show-icon": false,
        "min-length": 8,
        "hide-if-empty": true,
        "tooltip-spacing": 20
    },
    // The MX Ergo only reports a coarse battery-level (low/normal/high/full),
    // so this percentage steps between a few fixed values instead of counting
    // down; upower itself flags it "should be ignored".
    "upower#mouse": {
        "model": "Logitech MX Ergo",
        "format": "{percentage} ",
        "format-alt": "{percentage} {time} ",
        "show-icon": false,
        "min-length": 8,
        "hide-if-empty": true,
        "tooltip-spacing": 20
    },
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature#cpu": {
	<?php if (gethostname() === "felis"): ?>
        "hwmon-path": "/sys/class/hwmon/hwmon8/temp1_input",
	<?php else: ?>
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
	<?php endif ?>
        "critical-threshold": 80,
        "format": "CPU: {temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "temperature#gpu": {
	<?php if (gethostname() === "felis"): ?>
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
	<?php else: ?>
        "hwmon-path": "/sys/class/hwmon/hwmon9/temp1_input",
	<?php endif ?>
        "critical-threshold": 80,
        "format": "GPU: {temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
	"pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
	 "network": {
	 <?php if (gethostname() === "felis"): ?>
        "interface": "wlan0", 
	 <?php else: ?>
        "interface": "br0",
	<?php endif ?>
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
}
<?php if (gethostname() === "leopardus"): ?>
,
// Side screens: workspaces, tray and clock only.
{
	"output": ["HDMI-A-1", "DP-2"],
	"height": 36,
	"layer": "top",
	"position": "bottom",
	"modules-left": ["sway/workspaces", "sway/mode"],
	"modules-right": ["tray", "clock"],
	"sway/workspaces": {
		"format": "{name}",
		"enable-bar-scroll": true
	},
	"tray": {
		"spacing": 10
	},
	"clock": {
		"format-alt": "{:%a, %d. %b  %H:%M}"
	}
}
<?php endif ?>
]
